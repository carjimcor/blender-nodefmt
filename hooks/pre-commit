#!/bin/sh
# nodefmt pre-commit hook: stop the commit if a staged .blend has node trees that are not formatted.
# BLENDER: the Blender executable; NODEFMT: nodefmt_cli.py (defaults below).
# Rules and UI scale come from nodefmt.toml (found from the .blend's folder up); without ui-scale
# the check uses your Resolution Scale. NODEFMT_UI_SCALE overrides it, NODEFMT_ARGS adds options
# (for example --strict). Fix with: blender file.blend --python nodefmt_cli.py -- --fix
BLENDER=${BLENDER:-blender}
NODEFMT=${NODEFMT:-"$(git rev-parse --show-toplevel)/tools/nodefmt/nodefmt_cli.py"}
SCALE=${NODEFMT_UI_SCALE:+--ui-scale $NODEFMT_UI_SCALE}
status=0
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.blend'); do
  if ! git diff --quiet -- "$f"; then
    echo "nodefmt: $f has unstaged changes; checking the working copy"
  fi
  out=$("$BLENDER" "$f" --python "$NODEFMT" -- --check $SCALE $NODEFMT_ARGS 2>&1)
  if [ $? -ne 0 ]; then
    echo "$out" | grep -E "^[^ ]+: .*: NF[0-9]+ |^nodefmt:"
    echo "nodefmt: $f is not formatted"
    status=1
  fi
done
exit $status
